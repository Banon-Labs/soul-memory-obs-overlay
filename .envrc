export CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER=rust-lld

VS_MSVC_ROOT="/mnt/c/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC"
WIN_KITS_LIB_ROOT="/mnt/c/Program Files (x86)/Windows Kits/10/Lib"

if [ -d "$VS_MSVC_ROOT" ]; then
  MSVC_VER="$(ls -1 "$VS_MSVC_ROOT" | sort -V | tail -n 1)"
  VS_LIB_PATH="$VS_MSVC_ROOT/$MSVC_VER/lib/x64"
fi

if [ -d "$WIN_KITS_LIB_ROOT" ]; then
  WIN_KITS_VER="$(ls -1 "$WIN_KITS_LIB_ROOT" | sort -V | tail -n 1)"
  UCRT_LIB_PATH="$WIN_KITS_LIB_ROOT/$WIN_KITS_VER/ucrt/x64"
  UM_LIB_PATH="$WIN_KITS_LIB_ROOT/$WIN_KITS_VER/um/x64"
fi

if [ -n "$VS_LIB_PATH" ] && [ -n "$UCRT_LIB_PATH" ] && [ -n "$UM_LIB_PATH" ]; then
  export LIB="$VS_LIB_PATH;$UCRT_LIB_PATH;$UM_LIB_PATH"
fi
